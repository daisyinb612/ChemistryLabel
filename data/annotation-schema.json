  "rubric": [
    {
      "id": "Q1",
      "phase": "Q",
      "type": "动作",
      "name": "观察水样",
      "levels": [
        "未观察：接触水样容器后1秒内即开始倾倒，视线未在液面停留。",
        "简单观察：视线在水样上停留1秒至不足3秒（3秒归2分）。",
        "仔细观察：注视水样≥3秒；或眯眼、凑近、举杯对光、轻摇观察。"
      ],
      "max": 2
    },
    {
      "id": "PD1",
      "phase": "PD",
      "type": "动作",
      "name": "取水样",
      "levels": [
        "将全部水样用于实验，无水样留存。",
        "仅取用少量水样开展实验，剩余水样保留不作使用。"
      ],
      "max": 1
    },
    {
      "id": "DA1",
      "phase": "DA",
      "type": "动作",
      "name": "装填滤层",
      "levels": [
        "滤料填入无层次，所有材料混合倒入。",
        "粗细颠倒（细砂在上、粗砂在下），或脱脂棉不在出水端。",
        "最终装置从上到下为粗砂→细砂→棉／纸。"
      ],
      "max": 2
    },
    {
      "id": "DB1",
      "phase": "DA",
      "type": "状态",
      "name": "过滤装置状态",
      "levels": [
        "有效滤层n=0：无滤材，或仅有瓶盖无滤料。",
        "有效滤层n=1：一种材料形成有效层。",
        "有效滤层n=2：两种材料形成有效层。",
        "有效滤层n≥3：种类包括脱脂棉、细砂、粗砂。"
      ],
      "max": 3
    },
    {
      "id": "F1",
      "phase": "F",
      "type": "动作",
      "name": "进液",
      "levels": [
        "过滤层塌陷。",
        "玻璃棒引流或分次倾倒，流速平稳且滤层未塌陷；直接倾倒但未塌陷同样记1分。"
      ],
      "max": 1
    },
    {
      "id": "C1",
      "phase": "C",
      "type": "动作",
      "name": "加入氯化铁溶液",
      "levels": [
        "不滴加，直接重新搭建装置或继续后续操作。",
        "加氯化铁≥3滴。",
        "滴加氯化铁1—2滴。"
      ],
      "max": 2
    },
    {
      "id": "E1",
      "phase": "E",
      "type": "动作",
      "name": "出水观察",
      "levels": [
        "不检验：过滤完成后2秒内无视线停留，直接倒掉、放置一旁或进入下一轮。",
        "短暂注视滤液不足3秒，无对比、无辅助动作。",
        "与原水或自来水并排置于白纸／白墙背景对比；或举杯对光、倾斜、轻晃且注视≥5秒。"
      ],
      "max": 2
    },
    {
      "id": "R1",
      "phase": "R",
      "type": "动作",
      "name": "方案调整",
      "levels": [
        "停止迭代；或仅简单重复首轮过滤且滤液无澄清改善。",
        "以下三类有效调整实现1类。",
        "以下三类有效调整实现≥2类。"
      ],
      "max": 2
    },
    {
      "id": "E2_1",
      "phase": "E2",
      "type": "动作",
      "name": "再次出水观察",
      "levels": [
        "无对比观察，直接判断过滤效果是否达到任务条件。",
        "与原水或自来水并排置于白纸／白墙背景对比；或举杯对光、倾斜、轻晃且注视≥5秒。"
      ],
      "max": 1
    },
    {
      "id": "S1",
      "phase": "S",
      "type": "状态",
      "name": "最终溶液",
      "levels": [
        "与原水并排对比仍明显浑浊，无明显变化。",
        "明显变清，但边缘模糊，或有轻微颜色、细微悬浮颗粒。",
        "完全透明，无可见沉淀。"
      ],
      "max": 2
    }
  ]
